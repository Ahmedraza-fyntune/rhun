# find in files: smart case, opening a result selects the match, selection as the query
key ctrl+shift+f
type quokka
key Down
key Return
print-state
key ctrl+shift+f
key Return
print-state
key ctrl+shift+f
type Quokka
key Return
print-state
key ctrl+shift+f
type zzq
type qzz
key Return
print-state
key Escape
quit
