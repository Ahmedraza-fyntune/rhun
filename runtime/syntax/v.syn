name = V
files = *.v *.vsh v.mod
icon = code blue
comment = //
block = /* */
region = r' ' string
region = r" " string
string = " \
string = ' \
string = ` \
region = @[ ] attribute
region = # eol preproc bol
ident = $
prefix = @a
captypes = yes
keywords = as asm assert atomic break const continue defer dump else enum fn for go goto if import in interface is isreftype lock match module mut or pub return rlock select shared sizeof spawn static struct type typeof union unsafe volatile __global __offsetof _likely_ _unlikely_
types = bool string i8 i16 int i64 i128 u8 u16 u32 u64 u128 rune f32 f64 isize usize voidptr char any map chan thread
constants = true false none nil
preprocs = $if $else $for $embed_file $tmpl $env $d $compile_error $compile_warn $pkgconfig $res
builtins = println print eprintln eprint panic exit error arguments
